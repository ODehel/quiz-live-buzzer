// Modèle de src/secrets.h (ce dernier n'est jamais versionné, cf. .gitignore).
//
// Pour compiler l'environnement esp32 :
//   1. copier ce fichier en src/secrets.h
//   2. remplacer les valeurs ci-dessous par les vraies
//
// Les quatre macros sont des littéraux de chaîne, utilisés par main.cpp.
#ifndef SECRETS_H
#define SECRETS_H

// Réseau WiFi local auquel le buzzer se connecte
#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// Compte du buzzer sur le hub (POST /api/v1/token)
#define HUB_USERNAME "your-buzzer-username"
#define HUB_PASSWORD "your-buzzer-password"

#endif
